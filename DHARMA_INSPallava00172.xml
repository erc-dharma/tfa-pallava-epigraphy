                <ab>
                    <lb n="1"/><hi rend="grantha">svasti śrī</hi>
                </ab>
                
                <p>
                    kō-vicaiya-nirupat<choice><orig>o</orig><reg>u</reg></choice>ṅka-vi<hi rend="grantha">kra</hi>maṟkku yāṇṭu <num value="21">2 <g type="numeral">10</g> 1</num>-āvatu
                </p>
                <p>
                    milā
                    <lb n="2" break="no"/>ṭṭu-k kuṟukkai-k-kūṟṟattu tiru-k-kōvalūr tiru-v<choice><orig>i</orig><reg>ī</reg></choice>raṭṭāṉattu ma<hi rend="grantha">hāde</hi>varkku
                    na<choice><sic><hi rend="grantha">tnā</hi></sic><corr>ntā</corr></choice> viḷa
                    <lb n="3" break="no"/>kkiṉukku veṭṭuvataraiyarkku Aṟāmuṇṇum naṉṉaṉ koṟṟaṉ kuṭutta poṉ
                    <lb n="4"/><num value="12"><g type="numeral">10</g> 2</num> <g ref="sym:tam-kalancu"/>
                </p>
                <p>
                    paṉṉiru-kaḻañciṉ palicaiyālē-y iravum pa<supplied reason="omitted">ka</supplied>lum oru nontā viḷak
                    <lb n="5" break="no"/>k’ erippōm ā<choice><orig>n</orig><reg>ṉ</reg></choice>ōm tiru-k-kōvalūr nakarattōm <hi rend="grantha">candrādi</hi>ttaval
                </p>
                <p>
                    Itu pa<choice><orig>n</orig><reg>ṉ</reg></choice>-mā
                    <lb n="6" break="no"/><hi rend="grantha">heśvara-rakṣai</hi>
                </p>
                
