	<p>
		<lb n="1"/>kō-vicaiya-ciṅka-vi
		<lb n="2" break="no"/>ṇṇa-parumaṟku-p patiṉāṉk-āvatu
	</p>
	<p>
		<lb n="3" break="no"/>perum-pā<choice><orig>ṇṇ</orig><reg>ṇ</reg></choice>araicar makkaḷ cāt
		<lb n="4" break="no"/>taparāva<unclear>ṉā</unclear>r cēvakaṉ
		<lb n="5"/>vaṇṇa-<choice><orig>Ū</orig><reg>y-ū</reg></choice>r pā
		<lb n="6" break="no"/>vaṉ pūcal-uṭ pa
		<lb n="7" break="no"/>ṭṭa kal
	</p>
	
