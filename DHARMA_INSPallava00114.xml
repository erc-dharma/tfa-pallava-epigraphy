<div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:83215">
            
            <ab>
               <lb n="1"/><hi rend="grantha">śrī</hi>
            </ab>
            
            <p>               
               nanti-pō
               <lb n="2" break="no"/>ttarayar<supplied reason="omitted">k</supplied>ku yā
               <lb n="3" break="no"/>ṇṭu Iraṇṭ-āvatu
            </p>
            
            <p>
               <lb n="4"/>Amaṉi-kaṅkaraiyar
               <lb n="5"/>makaṉ celva-vā
               <lb n="6" break="no"/>ṇa-rayaṉ vittū
               <lb n="7" break="no"/>r āṇṭu ceyvit
               <lb n="8" break="no"/>ta muka-maṇṭaka
               <lb n="9" break="no"/>m

            </p>                       
                        
