      	<div type="edition" xml:lang="tam-Latn" rendition="class:vaṭṭeḻuttu maturity:83215">
      		
      		<p>
      			<lb n="1"/>kō-vicaiya-may<choice><sic>a</sic><corr>e</corr></choice>ntira-paruma
      			<lb n="2" break="no"/>ṟku Ēḻ-āvatu
      			
      		</p>
      		
      		<p>
      			kōvūr-nāṭṭu
      			<lb n="3" break="no"/>-k kāri-maṅkalaṅ kaṅkati A
      			<lb n="4" break="no"/>raicarōṭu
      			<lb n="5"/>purava<unclear>r</unclear>
      			<lb n="6"/>peṟṟāṇṭāṇ
      			<lb n="7"/>ṭāṉ ko
      			<lb n="8" break="no"/>m puḷi
      			<lb n="9" break="no"/>kaṇ maka
      			<lb n="10" break="no"/>ṉ Ēṟaṉ
      			<lb n="11" break="no"/>toṟuk ko
      			<lb n="12" break="no"/>ḷuṭ paṭ
      			<lb n="13" break="no"/>ṭāṉ kal      			
      		</p> 
      		
