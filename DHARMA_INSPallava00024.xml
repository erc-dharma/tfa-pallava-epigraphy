			<rdg source="bib:Hultzsch1896-1897_06">u<unclear>pa</unclear></rdg>
		</app>	
		
		<app loc="1">
			<lem>ida<orig><unclear>M</unclear></orig></lem>
			<rdg source="bib:Hultzsch1896-1897_06">i<unclear>da</unclear><choice><orig><unclear>M</unclear></orig><reg>ṁ</reg></choice></rdg>
			<note>The final <foreign><unclear>M</unclear></foreign> is written between lines 1 and 2, below the character <foreign>da</foreign>.</note>
		</app>	
		
		<app loc="2">
			<lem>śil<unclear>āM</unclear></lem>
			<note>The final <foreign><unclear>M</unclear></foreign> is written between lines 2 and 3, below the character <foreign>l<unclear>ā</unclear></foreign>.</note>
		</app>	
		
