                                <lb n="220" break="no"/>kkaṉūr <unclear>vi</unclear>ṭṭa<hi rend="grantha">śarmma-krama</hi>vi<hi rend="grantha">ttan</hi> paṅk’ oṉṟum <g ref="sym:flourish-taperOut" type="punctuation">.</g></item><item> vāyttalaikkum uvaṉṟikkum āka paṅku mūṉṟum <g ref="sym:flourish-taperOut" type="punctuation">.</g></item>
                            <item><lb n="221"/>Āttiraya-<hi rend="grantha">go<surplus>t</surplus>tra<supplied reason="omitted">t</supplied>tu Agni</hi>ve<hi rend="grantha">śyacū</hi>ttirattu-p puttūr-c comācikāri paṅk’ iraṇṭum</item>
