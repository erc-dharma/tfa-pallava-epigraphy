<div type="edition" xml:lang="tam-Latn" rendition="class:vaṭṭeḻuttu maturity:83215">
	
	<p>
		<lb n="1"/><unclear>mā</unclear>nta-parumaṟku pati
		<lb n="2" break="no"/>oṉṟ-āvatu
	</p>
	<p>
		koṅka
		<lb n="3" break="no"/>ṇi Araicaru paṭai-Ōṭu ciri
		<lb n="4" break="no"/>-kaṅkaraicaru caṅka-maṅkalat
		<lb n="5" break="no"/>t’ eṟinta ñāṉṟu ciri-kaṅkaraicaru
		<lb n="6"/>cēvakar-Ōṭu <gap reason="lost" quantity="1" unit="character" precision="low"/> kaṉāya		
		<lb n="7" break="no"/>r Eṟintu paṭṭa kal
	</p>
         	         	
         </div>

         <!--<div type="apparatus">

         	<listApp>
