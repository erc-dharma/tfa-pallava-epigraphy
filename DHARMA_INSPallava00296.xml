<div type="edition" xml:lang="tam-Latn" rendition="class:vaṭṭeḻuttu maturity:83215">	
	
	<p>
		<lb n="1"/>kō-vi<choice><orig>y</orig><reg>c</reg></choice>aiya-mayēntira-parumaṟku
		<lb n="2"/>yāṇṭu patiṉ-oṉr-āvatu
	</p>
	<p>		
		kīḻ-vēṇāṭ
		<lb n="3" break="no"/>ṭu-t tuṭari mēl vilakkumiṟai
		<lb n="4"/>yār vanta ñāṉṟu perum-pō
		<lb n="5"/> ttaraiyar maru-makkaḷ Amkō
		<lb n="6"/>ṭṭaiyār cēvakaṉ cākkai pa
		<lb n="7"/>ṟaiyaṉār Iḷa-makaṉ Ēṟaṉ
		<lb n="8"/>Eṟintu paṭṭāṉ
	</p>
	
</div>
      	
