            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:83215">
                
                <ab>
                    <lb n="1"/><hi rend="grantha">śrī</hi>
                </ab> 
                
                <p>
                    nirupatoṅka-p-pōt
                    <lb n="2" break="no"/>taraiyarkku yāṇṭu Ā
                    <lb n="3" break="no"/>ṟ-āvatu
                </p>
                <p>   
                    vaḷakūril <unclear>Ā</unclear>ḻu
                    <lb n="4" break="no"/>ntūr-nāṭṭu maṉṉār-<unclear>maṅ</unclear>
                    <lb n="5" break="no"/><unclear>kalam aṟa</unclear>miḷippāruḻāṉ vaḷakū
                    <lb n="6" break="no"/>r ce<choice><orig>yi</orig><reg>y</reg></choice>vitta tūmpu   
                </p>
                
            </div>
            
