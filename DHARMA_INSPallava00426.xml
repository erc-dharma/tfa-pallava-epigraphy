            <div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:83215"><!--confirm script-->
                
                <p>
                    <lb n="1"/>kō-vicaiya-nanti<choice><orig>c</orig><reg>cc</reg></choice>ura-parumaṟk
                    <lb n="2" break="no"/>ku yāṇṭu muppattēḻā
                    <lb n="3" break="no"/>vatu
                </p>
                
                <p>
                    vaḷḷipēṭu-nāṭuṭaiya vik
                    <lb n="4" break="no"/>kiramāttiya nāṭu mārikappā
                    <lb n="5" break="no"/>kiḻār makaṉ vakkaṭi paṭṭāṉ
                </p>
                
            </div>
            
