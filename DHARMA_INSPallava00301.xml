         	<listApp>
         		
         		<app loc="4">
         			<lem>cēvakaṉ</lem>
         			<note>According to <ptr target="bib:Nakacami1972_01"/>, <foreign>cēvakaṉ</foreign> is corrected from <foreign>cēvakar</foreign> by the engraver.</note>
         		</app>
         		
