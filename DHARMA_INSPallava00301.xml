<div type="edition" xml:lang="tam-Latn" rendition="class:vaṭṭeḻuttu maturity:83215">
	
	<p>
		<lb n="1"/>kō-vic<choice><orig>a</orig><reg>ai</reg></choice>ya-naraci
		<lb n="2" break="no"/>ṅka-parumaṟku yāṇṭu paṉṉiraṇ
		<lb n="3" break="no"/>ṭ-āvatu		
	</p>
	
	<p>
		mīkoṉṟai-nāṭṭu pācāṟṟu pakaima
		<lb n="4" break="no"/>tar cēvakaṉ toṟu Iṭuvittu paṭṭāṉ pa		
		<lb n="5" break="no"/>ṇaya nāttaṉ		
	</p>
         	         	
         </div>

