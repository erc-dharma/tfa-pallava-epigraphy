<div type="edition" xml:lang="tam-Latn" rendition="class:vaṭṭeḻuttu maturity:83215">	
	
	<p>
		<lb n="1"/>perum-pāṇaraicaru mēk
		<lb n="2" break="no"/>kaṭaliṟaiyaru cēvakaṉ
		<lb n="3"/>kākka-nīlaṉ pūcal ce
		<lb n="4" break="no"/>ṉṟu paṭṭa kal

	</p>
	
