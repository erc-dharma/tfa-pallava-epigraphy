<div type="edition" xml:lang="tam-Latn" rendition="class:tamil maturity:83215"><!--Vaṭṭeḻuttu?-->
      		
      		<p>
      			<lb n="1"/>kō-vicai<supplied reason="omitted">ya</supplied>-naraiciṅka-paruma
      			<lb n="2" break="no"/>ṟkk<choice><sic>i</sic><corr>u</corr></choice> yāṇṭu Irupatt<choice><sic>i</sic><corr>u</corr></choice> nāl-Āvatu
      			
      		</p>
      		<p>
      			<lb n="3"/>vañci<choice><orig>k</orig><reg>kk</reg></choice>uḻi Uṭai<choice><orig>A</orig><reg>ya</reg></choice>ṉ kalimanta Ati
      			<lb n="4"/>Araicaṉ Aṟa<choice><orig>Ū</orig><reg>yū</reg></choice>r mēl ceṉṟu paṭṭāṉ      			
      		</p>
      		
      	</div>

         <div type="apparatus">

         	<listApp>
         		
         		<app loc="1">
         			<lem>°vicai<supplied reason="omitted">ya</supplied>°</lem>
